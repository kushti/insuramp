<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: the local demo backend is plain HTTP on the device loopback
     (adb reverse tcp:8080 tcp:8080 forwards it to the host). Scoped to
     127.0.0.1 — nothing else may go cleartext. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
